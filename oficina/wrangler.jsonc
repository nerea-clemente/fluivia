// Oficina de Fluivia (Worker «fluivia-oficina»).
// Sirve la carpeta publico/ (solo con sesión, salvo la página de entrada) y guarda
// los datos en un Durable Object con SQLite en la UE. También recibe los
// formularios de la web (pedir demo y contacto) y los convierte en contactos.
{
  "name": "fluivia-oficina",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./publico",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "OFICINA", "class_name": "Oficina" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Oficina"] }],
  // Copias de seguridad cada noche, en un bucket de R2 en la UE (créalo con
  // `npx wrangler r2 bucket create fluivia-oficina-copias --jurisdiction eu`).
  "r2_buckets": [
    { "binding": "COPIAS", "bucket_name": "fluivia-oficina-copias", "jurisdiction": "eu" }
  ],
  // 02:30 copia de seguridad · 07:45 resumen de «hoy te toca» por correo (hora UTC).
  "triggers": { "crons": ["30 2 * * *", "45 6 * * *"] },
  "observability": { "enabled": true },
  // Los secretos van en Cloudflare con `npx wrangler secret put`, nunca aquí:
  //   RESEND_API_KEY   clave de Resend
  //   ENTRADA_SECRETO  la misma que OFICINA_SECRETO en Netlify (formularios de la web)
  "vars": {
    // Quién puede entrar (código por email), separados por comas.
    "EMAILS_PERMITIDOS": "hola@fluivia.ai,info.fluivia@gmail.com",
    "REMITENTE": "Fluivia <hola@fluivia.ai>",
    // A dónde llegan los avisos (demo pedida, mensaje de la web, resumen diario).
    "AVISOS": "hola@fluivia.ai,info.fluivia@gmail.com",
    // Webs desde las que se aceptan los formularios.
    "WEB_ORIGENES": "https://fluivia.es,https://www.fluivia.es,https://fluivia.ai,https://www.fluivia.ai,https://fluivia.dk,https://www.fluivia.dk",
    // La demo privada y el enlace para reservar llamada (opcional).
    "DEMO_URL": "https://fluivia.es/d/r5x0kruj/",
    // Dónde está la Oficina (para los enlaces de los avisos). En la misma cuenta de
    // Cloudflare que Study and Beyond, como sab2-backlog.studyandbeyond.workers.dev.
    "OFICINA_URL": "https://fluivia-oficina.studyandbeyond.workers.dev",
    "CITA_URL": ""
  }
}
